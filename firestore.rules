rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAuthed() {
      return request.auth != null;
    }

    function isApproved() {
      let u = userDoc();
      return u.aprovado == true && u.ativo != false;
    }

    function userRole() {
      return userDoc().role;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isSupervisorOrAdmin() {
      return userRole() == 'admin' || userRole() == 'supervisor';
    }

    // ─── usuarios ───────────────────────────────────────────────
    // Cada usuário lê e cria o próprio doc (necessário no primeiro login).
    // Admin pode ler e atualizar qualquer doc.
    // Ninguém (exceto admin) pode alterar campos de permissão no próprio doc.
    match /usuarios/{uid} {
      allow read:   if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthed() && request.auth.uid == uid;
      allow update: if isAuthed() && (
        isAdmin()
        || (
          request.auth.uid == uid
          // Bloqueia alteração de campos de permissão pelo próprio usuário
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'aprovado', 'ativo', 'representadasPermitidas', 'alertasDeUsuarios'])
        )
      );
      allow delete: if isAuthed() && isAdmin();
    }

    // ─── usuarios_mfa (apenas Admin SDK) ────────────────────────
    // O cliente nunca acessa esta coleção diretamente.
    // Toda escrita/leitura é feita pelo backend Express via Admin SDK.
    match /usuarios_mfa/{uid} {
      allow read, write: if false;
    }

    // ─── ofertas ────────────────────────────────────────────────
    // Leitura aberta a todos aprovados — filtro de permissão feito pelo cliente JS.
    // Queries de coleção (get/onSnapshot) falham se a regra depende de resource.data.
    match /ofertas/{id} {
      allow read:   if isAuthed() && isApproved();
      allow create: if isAuthed() && isApproved();
      allow update: if isAuthed() && isApproved();
      allow delete: if isAuthed() && isAdmin();
    }

    // ─── alertas ────────────────────────────────────────────────
    // Leitura e criação abertas a todos aprovados (filtro feito no cliente JS).
    // Update: admin/supervisor podem alterar qualquer campo.
    //         Usuários comuns só podem:
    //           · Solicitar resolução/ignorar (status → aguardando_*)
    //           · Adiar / snooze (status → adiado)
    //           · Marcar como lido (status não muda — resource.data.status == request.resource.data.status)
    match /alertas/{id} {
      allow read:   if isAuthed() && isApproved();
      allow create: if isAuthed() && isApproved();
      allow update: if isAuthed() && isApproved() && (
        isSupervisorOrAdmin()
        || resource.data.status == request.resource.data.status        // status inalterado (ex: marcar lido)
        || request.resource.data.status in [
             'aguardando_aprovacao_resolucao',
             'aguardando_aprovacao_ignorar',
             'adiado'
           ]
      );
      allow delete: if isAuthed() && isAdmin();
    }

    // ─── clientes ───────────────────────────────────────────────
    // Catálogo compartilhado: todos aprovados leem, criam, editam e mandam p/ lixeira.
    // Delete físico permanente: apenas admin.
    match /clientes/{id} {
      allow read:   if isAuthed() && isApproved();
      allow create: if isAuthed() && isApproved();
      allow update: if isAuthed() && isApproved();
      allow delete: if isAuthed() && isAdmin();
    }

    // ─── representadas ──────────────────────────────────────────
    match /representadas/{id} {
      allow read:   if isAuthed() && isApproved();
      allow create: if isAuthed() && isApproved();
      allow update: if isAuthed() && isApproved();
      allow delete: if isAuthed() && isAdmin();
    }

    // ─── projetos ───────────────────────────────────────────────
    match /projetos/{id} {
      allow read:   if isAuthed() && isApproved();
      allow create: if isAuthed() && isApproved();
      allow update: if isAuthed() && isApproved();
      allow delete: if isAuthed() && isAdmin();
    }

    // ─── logs de auditoria ──────────────────────────────────────
    // Qualquer usuário aprovado pode gravar (write = create apenas).
    // Leitura e delete: apenas admin.
    match /logs/{id} {
      allow create: if isAuthed() && isApproved();
      allow read:   if isAuthed() && isAdmin();
      allow update: if false;
      allow delete: if isAuthed() && isAdmin();
    }

    // ─── backups (apenas admin) ──────────────────────────────────
    match /backups/{id} {
      allow read, write: if isAuthed() && isAdmin();

      match /{subcollection=**} {
        allow read, write: if isAuthed() && isAdmin();
      }
    }
  }
}
