# Backend — Correlação de Cabos
# Copie este arquivo para backend/.env e preencha a chave. NUNCA commite o .env real.

# Chave da API da Anthropic — https://console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=

# Estratégia de custo (2 passadas): o modelo RÁPIDO (barato) processa tudo;
# o modelo FORTE só re-processa os itens que ficaram pendência/ambíguo.
# Se não definir, usa os defaults abaixo.
CLAUDE_MODEL_RAPIDO=claude-haiku-4-5-20251001
CLAUDE_MODEL_FORTE=claude-sonnet-4-6
# CLAUDE_MODEL é o fallback do FORTE (compatibilidade):
CLAUDE_MODEL=claude-sonnet-4-6

# Opcional: caminho da planilha (default = TABELA USO INTERNO*.xlsx mais recente na raiz)
# TABELA_PATH=../TABELA USO INTERNO_JUNHO26.xlsx
